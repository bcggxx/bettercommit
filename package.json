{
    "name": "bettercommit",
    "displayName": "BetterCommit — AI Commit Message Generator",
    "description": "Generate conventional commit messages from git diffs using AI (OpenCode Zen, OpenAI, OpenRouter & more) — directly in VS Code's Source Control panel. Forked from cihatksm/opencommit.",
    "version": "1.3.2",
    "publisher": "bcggxx",
    "author": {
        "name": "bcggxx",
        "email": "191667089+bcggxx@users.noreply.github.com",
        "url": "https://github.com/bcggxx"
    },
    "license": "MIT",
    "icon": "icon.png",
    "homepage": "https://github.com/bcggxx/bettercommit#readme",
    "bugs": {
        "url": "https://github.com/bcggxx/bettercommit/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bcggxx/bettercommit"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "SCM Providers",
        "Other"
    ],
    "keywords": [
        "commit",
        "git",
        "conventional commits",
        "ai",
        "opencode"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "bettercommit.generateCommitMessage",
                "title": "✨ Generate Commit",
                "category": "BetterCommit"
            },
            {
                "command": "bettercommit.regenerateCommitMessage",
                "title": "✨ Regenerate",
                "category": "BetterCommit"
            },
            {
                "command": "bettercommit.setApiToken",
                "title": "🔑 Set API Token",
                "category": "BetterCommit"
            }
        ],
        "menus": {
            "scm/title": [
                {
                    "command": "bettercommit.generateCommitMessage",
                    "when": "scmProvider == git",
                    "group": "navigation",
                    "icon": "$(sparkle)"
                }
            ],
            "scm/inputBox": [
                {
                    "command": "bettercommit.generateCommitMessage",
                    "when": "scmProvider == git",
                    "group": "navigation",
                    "icon": "$(sparkle)"
                }
            ],
            "commandPalette": [
                {
                    "command": "bettercommit.generateCommitMessage",
                    "when": "scmProvider == git"
                },
                {
                    "command": "bettercommit.regenerateCommitMessage",
                    "when": "scmProvider == git"
                }
            ]
        },
        "configuration": {
            "title": "BetterCommit",
            "properties": {
                "commitMessageGenerator.apiBaseUrl": {
                    "type": "string",
                    "default": "https://opencode.ai/zen/v1/chat/completions",
                    "description": "The API endpoint URL.\nOpenCode Zen tiers:\n- Free: https://opencode.ai/zen/v1/chat/completions\n- Go: https://opencode.ai/zen/go/v1/chat/completions\n- Go (Messages API): https://opencode.ai/zen/go/v1/messages\n\nOther providers:\n- OpenAI: https://api.openai.com/v1/chat/completions\n- OpenRouter: https://openrouter.ai/api/v1/chat/completions\n- Groq: https://api.groq.com/openai/v1/chat/completions\n- DeepSeek: https://api.deepseek.com/v1/chat/completions\n- Anthropic: https://api.anthropic.com/v1/messages\n- Ollama (local): http://localhost:11434/v1/chat/completions\n- Or type \"opencode-cli\" to use the local OpenCode CLI tool."
                },
                "commitMessageGenerator.apiProvider": {
                    "type": "string",
                    "default": "auto",
                    "enum": [
                        "auto",
                        "openai",
                        "anthropic"
                    ],
                    "enumDescriptions": [
                        "Auto-detect from apiBaseUrl (anthropic.com -> Anthropic Messages API, otherwise OpenAI-compatible).",
                        "Always use the OpenAI-compatible chat/completions client.",
                        "Always use the native Anthropic Messages API client (x-api-key + anthropic-version headers, top-level system field)."
                    ],
                    "description": "Which API protocol to use when calling the model. Use \"auto\" to detect from apiBaseUrl, or force \"anthropic\" to use the native Messages API."
                },
                "commitMessageGenerator.model": {
                    "type": "string",
                    "default": "deepseek-v4-flash-free",
                    "description": "The AI model to use. Works with any model your API provider supports.",
                    "enum": [
                        "deepseek-v4-flash-free",
                        "deepseek-v4-pro",
                        "deepseek-v4-flash",
                        "kimi-k2.6",
                        "kimi-k2.5",
                        "glm-5.1",
                        "glm-5",
                        "mimo-v2.5",
                        "mimo-v2.5-pro",
                        "mimo-v2.5-free",
                        "minimax-m3",
                        "minimax-m2.7",
                        "minimax-m2.5",
                        "minimax-m3-free",
                        "qwen3.7-max",
                        "qwen3.7-plus",
                        "qwen3.6-plus",
                        "qwen3.6-plus-free",
                        "nemotron-3-super-free",
                        "opencode-gen/kimi-k2.6",
                        "gpt-4o-mini",
                        "gpt-4o",
                        "claude-3-5-sonnet",
                        "claude-3-5-sonnet-20241022",
                        "claude-3-5-haiku-20241022",
                        "claude-sonnet-4-20250514",
                        "claude-opus-4-1-20250805",
                        "custom (type in settings.json)"
                    ]
                },
                "commitMessageGenerator.promptModel": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a model picker every time before generating a commit message. Disable to always use the default model silently."
                },
                "commitMessageGenerator.conventionalCommit": {
                    "type": "boolean",
                    "default": true,
                    "description": "Generate messages in Conventional Commit format (e.g., feat:, fix:, refactor:)."
                },
                "commitMessageGenerator.multiLine": {
                    "type": "boolean",
                    "default": false,
                    "description": "Generate multi-line commit messages with a body explaining the changes."
                },
                "commitMessageGenerator.maxDiffLength": {
                    "type": "number",
                    "default": 4000,
                    "description": "Maximum diff length (characters) to send to the API. Larger diffs are truncated intelligently."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src",
        "package": "npx @vscode/vsce package",
        "publish": "vsce publish",
        "build-install": "powershell -ExecutionPolicy Bypass -File ./scripts/build-install.ps1",
        "build-install:minor": "powershell -ExecutionPolicy Bypass -File ./scripts/build-install.ps1 minor",
        "build-install:major": "powershell -ExecutionPolicy Bypass -File ./scripts/build-install.ps1 major"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.0.1",
        "@types/vscode": "^1.125.0",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^10.8.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "dependencies": {
        "simple-git": "^3.36.0"
    }
}
